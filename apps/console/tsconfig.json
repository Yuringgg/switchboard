{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Overrides the base's Node-oriented settings for a bundler + DOM target.
    // Strictness (strict, noUncheckedIndexedAccess, verbatimModuleSyntax,
    // noUnusedLocals) is inherited deliberately — the console is not exempt.
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
