# Secrets — never commit. If one ever lands in history, ROTATE it, don't just
# delete the line. See docs/02-ARCHITECTURE.md §6.
.env
.env.*
!.env.example

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Regenerated by Next on every dev/build, and its contents differ between the
# two (.next/types vs .next/dev/types) — so it can never sit still in a repo
# where both are run. Verified that `tsc --noEmit` passes without it.
next-env.d.ts

# Test + coverage
coverage/
.vitest/

# Local model cache — Transformers.js downloads ONNX weights here
.cache/
models/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Vercel / Azure local state
.vercel
.azure
