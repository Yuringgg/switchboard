# Switchboard — environment template
#
# Copy to `.env.local` and fill in. `.env*` is gitignored; `.env.example` is not.
# Deployed secrets live in Vercel env vars and Azure Container Apps secrets —
# never in the repo, never in a doc, never in a chat message.
#
# Nothing below exists yet. The checklist is docs/03-RESOURCES.md §6.

# ─── Supabase ────────────────────────────────────────────────────── Phase 0 ──
# Create in ap-southeast-1 (Singapore) — closest to Manila, immutable after
# creation. Free tier allows 2 active projects; do not create a third.
# Console (apps/console/.env.local). Browser-exposed BY DESIGN: the publishable
# key carries no privileges of its own and every query it makes is filtered by
# RLS against the user's session.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Worker only (apps/worker/.env). Not needed until the worker exists.
SUPABASE_URL=

# ⚠ service_role BYPASSES ROW LEVEL SECURITY — it reads every tenant's messages
#   and no policy stops it. Server-side only, never in a NEXT_PUBLIC_ variable,
#   never in an app that ships code to a browser. Fetch it from the Supabase
#   dashboard; it is deliberately not retrievable through tooling.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Channel credential encryption ───────────────────────────────── Phase 0 ──
# AES-256-GCM key for `channels.credentials`. 32 random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHANNEL_CREDENTIALS_KEY=

# ─── Google: Gmail + Calendar ────────────────────────────────────── Phase 1 ──
# One Cloud project, one OAuth client, both scopes in the same consent screen —
# asking for calendar.events now saves a second consent in Phase 5 (ADR-010).
# Keep the consent screen in TESTING mode with allowlisted users: publishing with
# Gmail restricted scopes triggers a Google CASA assessment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Pub/Sub topic for Gmail push. Grant publish rights to
# gmail-api-push@system.gserviceaccount.com.
GOOGLE_PUBSUB_TOPIC=

# ─── WhatsApp Cloud API ──────────────────────────────────────────── Phase 2 ──
# Free test business number, up to 5 verified recipients, no business
# verification. Full setup checklist: docs/03-RESOURCES.md §6.
#
# Meta dashboard → WhatsApp → API Setup. Opaque and stable; this is the value
# the webhook resolves a TENANT by, stored in channels.external_account_id.
# Not the display number.
WHATSAPP_PHONE_NUMBER_ID=

# Same page. The temporary token lasts 24 hours; generate a System User token
# before anything that must keep working. Used to download media in Phase 3.
WHATSAPP_ACCESS_TOKEN=

# ⚠ App settings → Basic → App Secret. NOT the access token — confusing the two
# makes every webhook 401, which reads as Meta being broken rather than as a
# wrong value. This is the key X-Hub-Signature-256 is verified against.
WHATSAPP_APP_SECRET=

# Any long random string you invent. Meta echoes it back during the subscription
# handshake and it is compared timing-safely; a mismatch 403s.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ─── AI providers ────────────────────────────────────────────────── Phase 4 ──
# Groq runs BOTH AI workloads now, on two different models so their per-model
# limits cannot exhaust each other:
#   llama-3.1-8b-instant     summaries  (Phase 4A) — 14,400 req/day
#   llama-3.3-70b-versatile  assistant  (Phase 4B) —  1,000 req/day
GROQ_API_KEY=

# ⚠⚠ GEMINI IS NO LONGER THE ASSISTANT'S PROVIDER.
# Its free tier is TWENTY requests per DAY — measured from the quota error on
# 2026-08-02, not the 250 the docs recorded. One eval run needs 15. Optional
# now; set ASSISTANT_PROVIDER=gemini to switch back if Google restores a usable
# tier. ⚠ KEEP BILLING DISABLED — enabling it permanently destroys the free
# tier, with no undo.
GEMINI_API_KEY=

# `groq` (default) or `gemini`.
ASSISTANT_PROVIDER=groq

# Embeddings need no key — they run locally via Transformers.js (ADR-003):
# free, unlimited, offline, and impossible to exhaust mid-demo. The model must
# stay MULTILINGUAL; the corpus is Taglish and an English-only model degrades in
# a way that looks like a ranking bug.
EMBEDDING_MODEL=Xenova/multilingual-e5-small

# Where the 129 MB quantised model is cached. Set in the worker's image so it
# survives for the life of the container rather than downloading per request.
MODEL_CACHE_DIR=

# ─── The assistant's embedding hop ──────────────────────────────── Phase 4B ──
# The console cannot run the embedding model itself — 129 MB plus native ONNX
# binaries in a serverless function means a ~35s cold start, and a demo's first
# question IS a cold start. So it asks the worker, which holds the model warm
# for exactly this reason (ADR-011).
#
# ⚠ This is the only reason the worker needs public ingress, and this secret is
# the only thing gating it. Long and random. Unset means the endpoint is
# DISABLED, never open.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMBED_API_SECRET=

# Console only — the worker's public HTTPS origin, no trailing path.
# e.g. https://switchboard-worker.<env>.malaysiawest.azurecontainerapps.io
EMBED_API_URL=

# ─── Azure Blob Storage ──────────────────────────────────────────── Phase 1 ──
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=attachments
